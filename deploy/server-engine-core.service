[Unit]
Description=Server Engine Python control plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/server-engine/core
ExecStart=/opt/server-engine/core/run.sh
Restart=on-failure
RestartSec=3
# The control plane owns installation, package, firewall, port, ownership,
# and service-management operations. Managed service workers still drop to
# the dedicated serverengine account in their own configurations.
User=root

[Install]
WantedBy=multi-user.target
